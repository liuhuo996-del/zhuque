# Docker 对外端口；容器内固定使用 8081
GATEFORGE_HTTP_PORT=8081

# 本地直接运行 Python 时使用；Docker Compose 会覆盖为 /data/gateforge.db
GATEFORGE_DATABASE_PATH=./backend/data/gateforge.db

# Optional AI enrichment and L2 semantic selection (OpenAI-compatible)
GATEFORGE_AI_BASE_URL=
GATEFORGE_AI_API_KEY=
GATEFORGE_AI_MODEL=

# Nacos 3 AI/MCP Registry official Admin API
# 从容器访问宿主机 Nacos 时使用 host.docker.internal；同一 Docker 网络可改成服务名
GATEFORGE_NACOS_SERVER_URL=http://host.docker.internal:8848
GATEFORGE_NACOS_CONTEXT_PATH=/nacos
GATEFORGE_NACOS_NAMESPACE=public
GATEFORGE_NACOS_USERNAME=
GATEFORGE_NACOS_PASSWORD=

# Comma-separated security allowlists
GATEFORGE_ALLOWED_SPEC_HOSTS=
GATEFORGE_ALLOW_PRIVATE_SPEC_HOSTS=false
GATEFORGE_L1_ALLOW_ORIGINS=
GATEFORGE_L1_ALLOW_UNSAFE_METHODS=false
GATEFORGE_QUALITY_THRESHOLD=0.78
